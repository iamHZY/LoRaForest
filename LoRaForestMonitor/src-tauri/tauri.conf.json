{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "loraforest_monitor",
  "version": "1.0.0",
  "identifier": "com.ricardo.loraforest.monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "基于LoRa的森林气象因子监测系统",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows":{
      "nsis":{
        "languages": ["SimpChinese"]
      },
      "wix":{
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
